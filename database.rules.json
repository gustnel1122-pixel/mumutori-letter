{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    },
    "letters": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['type', 'order', 'envelope', 'consent', 'createdAt']) && (newData.child('type').val() === 'print' || newData.child('type').val() === 'ghost')",
        "letter": { "body": { ".validate": "newData.isString() && newData.val().length <= 2000" } },
        "memo": { ".validate": "newData.isString() && newData.val().length <= 600" }
      }
    },
    "hub": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
