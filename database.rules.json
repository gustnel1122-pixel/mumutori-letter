{
  "rules": {
    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com'))",
      ".write": false
    },
    "config": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com'))"
    },
    "letters": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com'))",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com')))",
        ".validate": "newData.hasChildren(['type', 'order', 'envelope', 'consent', 'createdAt']) && (newData.child('type').val() === 'print' || newData.child('type').val() === 'ghost')",
        "letter": {
          "body": {
            ".validate": "newData.isString() && newData.val().length <= 2000"
          }
        },
        "memo": {
          ".validate": "newData.isString() && newData.val().length <= 600"
        }
      }
    },
    "hub": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com'))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.token.email_verified == true && auth.token.email == 'gustnel1122@gmail.com'))"
    }
  }
}